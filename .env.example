# Temporal Cloud connection (API key auth)
# Address looks like: <region>.<cloud_provider>.api.temporal.io:7233
TEMPORAL_ADDRESS=us-west-2.aws.api.temporal.io:7233
TEMPORAL_NAMESPACE=quickstart-abhishek-b8746e8b.jftpi
TEMPORAL_API_KEY=

# Task queue the showcase worker polls and clients target
TEMPORAL_TASK_QUEUE=showcase

# Task queue for the durable Temporal Agents worker (`npm run agent-worker`)
TEMPORAL_AGENTS_TASK_QUEUE=showcase-agents

# Optional: label printed by the worker and reportWorkerIdentity activity.
# Useful when two workers run on the same machine (e.g. WORKER_LABEL=A / WORKER_LABEL=B).
# WORKER_LABEL=A

# Model provider (Gemini) — required for `npm run agent-worker` / durableTemporalAgent.
# Prefer GEMINI_API_KEY; GOOGLE_API_KEY is accepted as an alias (same Google AI Studio key).
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# Official model id: gemini-3.8-flash (Gemini 3.8 Flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional legacy: also enables live summarization in summarizeFindings via Gemini
# when GEMINI_API_KEY / GOOGLE_API_KEY is set. OPENAI_API_KEY is unused by the agent path.
# OPENAI_API_KEY=
