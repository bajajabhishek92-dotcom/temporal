# Temporal Cloud connection (API key auth)
# Address looks like: <region>.<cloud_provider>.api.temporal.io:7233
TEMPORAL_ADDRESS=us-west-2.aws.api.temporal.io:7233
TEMPORAL_NAMESPACE=quickstart-abhishek-b8746e8b.jftpi
TEMPORAL_API_KEY=

# Task queue the showcase worker polls and clients target
TEMPORAL_TASK_QUEUE=showcase

# Task queue for the durable OpenAI Agents worker (`npm run agent-worker`)
TEMPORAL_AGENTS_TASK_QUEUE=showcase-agents

# Optional: label printed by the worker and reportWorkerIdentity activity.
# Useful when two workers run on the same machine (e.g. WORKER_LABEL=A / WORKER_LABEL=B).
# WORKER_LABEL=A

# Model provider (OpenAI) — required for `npm run agent-worker` / durableTemporalAgent.
# Also enables live summarization in the older summarizeFindings activity;
# without it, that activity returns a deterministic stub.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

