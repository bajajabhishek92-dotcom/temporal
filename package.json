{
  "name": "temporal-showcase",
  "version": "1.0.0",
  "description": "Temporal Cloud showcase: workflows, workers, durable Gemini agents, and an MCP server",
  "private": true,
  "scripts": {
    "build": "tsc --build",
    "build.watch": "tsc --build --watch",
    "worker": "tsx src/worker.ts",
    "agent-worker": "tsx src/agents/worker.ts",
    "start-workflow": "tsx src/client.ts",
    "start-agent": "tsx src/agents/client.ts",
    "start-worker-demo": "tsx src/start-worker-demo.ts",
    "signal-approve": "tsx src/signal-approve.ts",
    "mcp": "tsx src/mcp/server.ts",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@openai/agents-core": "~0.14.3",
    "@openai/agents-openai": "~0.14.3",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/openai-agents": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "dotenv": "^16.4.7",
    "openai": "^6.46.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
